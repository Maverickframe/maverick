            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "<p><strong>Book a meeting<\/strong> with a business development manager at Maverick Frame to discuss your new upcoming project and see our best work:<\/p>\r\n<ul>\r\n<li>Take a look behind the scenes of our work and see how <strong>product renders are created from scratch<\/strong> — from a plain model to a fully textured object.<\/li>\r\n<li>Explore how our team of 3D artists <strong>brings ideas to life<\/strong><\/li>\r\n<li>Discover our additional services, including <strong>motion design and 2D animation<\/strong><\/li>\r\n<li>Get a <strong>free consultation<\/strong> with a 3D artist about your project development right during the meeting.<\/li>\r\n<li><strong>Browse our portfolio<\/strong> — we’ll handpick the most relevant examples tailored specifically to your needs.<\/li>\r\n<\/ul>",
            "placeholder": "",
            "maxlength": "",
            "rows": "",
